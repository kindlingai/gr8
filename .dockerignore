# Keep the build context to tracked source. Build outputs and local configs stay out of both the builder and the
# runtime image.
.git
.github
bin*
**/target
**/__pycache__
**/*.pyc
**/*.log
bench/results*.jsonl
config/cluster.env
frontend/tests/work
docker/.env
# A checkout used on bare metal: its cluster.env (the launcher in /opt/gr8 would read it, over docker/.env), and the
# state of a GR8_WORK_DIR left at the checkout (out/ is also what `docker build --target dist -o out` writes).
cluster.env
out
run
s2
serve
venv
packs
