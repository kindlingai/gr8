  "default_or_cache_changes": [
    {
      "scope": "qw38",
      "change": "GR8_QW38_DENSE_FP8=1, GR8_QW38_MTP_FAST=1, GR8_QW38_TRUNK_HEAD2=1, and GR8_QW38_PF_MXFP8=1 are enabled by default (#599).",
      "rollback": "Set GR8_QW38_PF_MXFP8=0 for FP16-scaled FP8 decode + BF16 cuBLAS prefill (KL=0.000051, 100.00% top-1 vs full rollback), GR8_QW38_TRUNK_HEAD2=0 for full-vocab FP8 lm_head, GR8_QW38_MTP_FAST=0 for FP8 draft head + host sync, or GR8_QW38_DENSE_FP8=0 for pure BF16 dense decode."
    },
    {
      "scope": "qw38 --reuse-prefix",
      "change": "Default fallback mem: prefix store now auto-sizes to clamp((max_pps + 2*state_blocks + 16) * slot_bytes, 512M, 4096M) instead of fixed 512M (#600).",
      "rollback": "Pass an explicit --kv-store (e.g. --kv-store mem:,size=512M)."
    },
    {
      "scope": "KV_STORE=ssd:...",
      "change": "Persistent session index resets once on binary upgrade while preserving the preallocated SSD block file.",
      "rollback": "None required; active sessions prefill once on first boot."
    }
  ],
  "toolchain_changes": [
    "Dockerfile adds engine-qw38 / dist-qw38 (shipping bin/g6m4_qw38 and bin/m4sim_qw38, #577) and splits shipped test binaries into dist-tests (#597); CUDA (13.0.1), base OS (ubuntu24.04), Rust (1.94.1), and runtime apt packages are unchanged."
  ],
  "operational_notes": [
    "Recommended upgrade for all GLM-5.3 TP=4 and TP=6 deployments: adds TP=4 throughput/concurrency wins (#582) and fixes vocab-split grammar-masked head sampling and rejection sampling (#576 / #600).",
    "Introduces Qwen3.8-Flash-Next (qw38) support across TP=1..4 with vision (GR8_QW38_VISION=1), Layer-48 MTP (0..5), Record 9 row-trellis PLE, and auto-sized prefix reuse.",
    "Launcher cleanly rejects --shape ring for qw38 and ink2 (mesh only) and --flash-cache for qw38 (uses --kv-store directly)."
  ],
