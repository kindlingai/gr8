  "default_or_cache_changes": [
    {
      "scope": "glm53 TP=4/5/6",
      "change": "TP=5 and TP=6 now default the v1.1.0 bit-exact tuned kernels, DEC_BK_MAX=2048, L2PF=31, PF_GEMMF32=1, MTP prefetch/lastrow/head2 tuning, and MOE_UNION_CAP=48; TP=4 also defaults L2PF=31, PF_GEMMF32=1, MTP prefetch/lastrow/head2 tuning, and DFL_REUSE_MIN=0 when DFLASH=1 (#554).",
      "rollback": "Set MOE_UNION_CAP=0 (--moe-union-cap 0) for strict uncapped exact routing (KL=0.00000); set MOE_UNION_CAP=32 for fast mode."
    },
    {
      "scope": "KV_STORE=ssd:...",
      "change": "Persistent session index resets once on binary upgrade while preserving the preallocated SSD block file.",
      "rollback": "None required; active sessions prefill once on first boot."
    }
  ],
  "toolchain_changes": [
    "Dockerfile adds bin/g6layout (#553) to dist; CUDA (13.0.1), base OS (ubuntu24.04), Rust (1.94.1), and runtime apt packages are unchanged."
  ],
  "operational_notes": [
    "Recommended upgrade for all GLM-5.3 TP=4 deployments: fixes the 150K+ multi-session CP staged index ordering bug (#557) that caused intermittent empty replies or reasoning loops on short follow-up chunks.",
    "Quality-first recipes (such as K4 bit387) continue to explicitly set MOE_UNION_CAP=0 to opt out of default MOE_UNION_CAP=48.",
    "New --pool (POOL) mode enables standby boxes and zero-restart Helm scaling with ./gr8 <model> scale --tp N (#547)."
  ],
