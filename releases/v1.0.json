  "default_or_cache_changes": [
    {
      "scope": "ds41 TP=4 prefill",
      "change": "Enables 12,288-row wide v2 prefill (GR8_DS_PF_V2=1, GR8_DS_PF_V2_W16K=1, GR8_DS_PREFILL_W=12288), layer-20 tail hoist (GR8_DS_PF_V2_L20_TAIL=1), and compact send + FFN unpack (GR8_DS_PF_V2_SEND_FFN_OPT=3) by default.",
      "numerical_note": "Cold 240-position teacher-forced mean_kl = 0.002218 (99.17% top-1 agreement) vs prior 8,192-row path.",
      "rollback": "--exact 1 (or EXACT=1)"
    },
    {
      "scope": "glm53 TP=4 KV format and INT4 attention",
      "change": "Defaults ./gr8 glm53 up at TP=4 to KV_FORMAT=int4 (bin/g6m4-int4, CAP=513536) with bit-exact INT4 fast paths (GR8_KV4_SC=4, GR8_KV4_SC_TR=2, GR8_KV4_QT=1, GR8_KV4_CTX=2, GR8_KV4_FUSE_ROT=1), folded Hadamard weights (GR8_KV4_FOLD=1), BF16 wmma tensor-core INT4 decode (GR8_KV4_TC=1), and single-chain CP combine (GR8_CP_ONECHAIN=1).",
      "numerical_note": "KL(fp8 || int4) mean = 0.01450 (97.0% top-1 agreement); folded/TC vs bit-exact INT4 mean_kl = 0.015803 under live adaptive serving.",
      "rollback": "--kv-format fp8 (restores bin/g6m4 at CAP=485376), or --kv4-tc 0 --kv4-fold 0 --cp-onechain 0 for bit-exact KV_FORMAT=int4 (KL = 0.0)"
    },
    {
      "scope": "glm53f TP=2 KV_FORMAT=int4 multi-session scheduling",
      "change": "Defaults ./gr8 glm53f --tp 2 --kv-format int4 to SESS=4, MTP=3, GR8_S2_SHARED_WATERFILL=1, and GR8_S2_SHARED_WF_MARGIN=0.02.",
      "numerical_note": "Bit-identical solo greedy output (mean_kl = 0.0).",
      "rollback": "--s2-shared-waterfill 0 (restores MTP=1 when --mtp is unset) or --sess 1"
    }
  ],
