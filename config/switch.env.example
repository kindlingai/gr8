# ./gr8 switch glm53 @config/switch.env (or copy to ./switch.env).
# This file is local to the controller; values are literal, with no $ expansion.
# SSH keys and known_hosts must already work with BatchMode=yes. The controller
# must reach each head's health URL. Only one switch may run at a time.
BOXES=operator@192.0.2.1,operator@192.0.2.2,operator@192.0.2.3,operator@192.0.2.4

# Each list is in rank order, head first. Paths are absolute on the remote boxes,
# identical across that model's boxes. Provision each compose directory and its
# .env beforehand: this command does not rewrite model, rank, peer or port options.
# GLM-5.3: gr8's docker/ directory, .env with GR8_MODEL=glm53, TP=4.
GLM53_BOXES=operator@192.0.2.1,operator@192.0.2.2,operator@192.0.2.3,operator@192.0.2.4
GLM53_DIR=/opt/gr8/docker
GLM53_HEALTH_URL=http://192.0.2.1:8000/health

# GLM-5.3-Flash: its own compose directory, .env with GR8_MODEL=glm53f, TP=2.
GLM53F_BOXES=operator@192.0.2.1,operator@192.0.2.2
GLM53F_DIR=/opt/glm-5.3-flash-exlr8-2x-spark
GLM53F_HEALTH_URL=http://192.0.2.1:8100/health

# DeepSeek: its recipe repository's compose directory, configured for TP=4.
DS41_BOXES=operator@192.0.2.1,operator@192.0.2.2,operator@192.0.2.3,operator@192.0.2.4
DS41_DIR=/opt/deepseek-v4.1-flash-exlr8-4x-spark
DS41_HEALTH_URL=http://192.0.2.1:8100/health

# Seconds: health wait (polls every 0.1s), and each SSH/Compose operation.
# SSH_TIMEOUT must allow Compose's configured stop grace to finish.
TIMEOUT=900
SSH_TIMEOUT=300
# All other models are stopped on ALL their configured boxes, before any up.
# An SSH/Compose failure prevents the next phase; it names the box and exits nonzero.
# No automatic rollback: inspect the reported box before retrying the command.
