# TP5 "T5X" (five Sparks on one switch, mesh): the TP5 serve config. Copy to every box (same file on all five) and pass
# it as ./gr8 glm53 up @<file>. Measured numbers and the boot/stop steps: docs/TP5-SERVE.md. All knobs: KNOBS.md.

# Ranks in order; the first is the head (front end + shim). Fabric rail 1 and rail 2 addresses, same order everywhere.
TP=5
SHAPE=mesh
PEERS=10.0.1.1,10.0.1.2,10.0.1.3,10.0.1.4,10.0.1.5
IPS=10.0.1.1,10.0.1.2,10.0.1.3,10.0.1.4,10.0.1.5
IPS2=10.0.2.1,10.0.2.2,10.0.2.3,10.0.2.4,10.0.2.5

# Paths on each box (local disk). MODEL / V2_DENSE = the exlr8 K2-K3-K4 release; V2 / V2_SLICES = this rank's
# TP5 expert and index slices; G6_QO_CACHE = per-layer PF_OWN=3 head tensors, written on the first boot
# (~190 s), read on later boots (~47 s).
G6_HOME=/opt/g6
MODEL=/opt/g6/rel
V2_DENSE=/opt/g6/rel
V2=/opt/g6/tp5/experts
V2_SLICES=/opt/g6/tp5/index-slices
PY=/opt/g6/venv/bin/python

PROXY_CPU=19
PORT=8000
S2PORT=7341
READY_TMO=1800
NOHASH=0

# Serving shape: KV pool 617,536 tokens (max_model_len 617,532), 4 sessions, fp8 KV, MTP 2, no DFlash2.
CAP=617536
SESS=4
SHARE_LIMIT=4096
KVB=fp8
MTP=2
DFLASH=0
SPEC_ADAPT=0
PF_OWN=3
QA_SPLIT=1
IDXQ_SPLIT=1
MTP_SPLIT=1
K1_TLBW=2048
G6ENV_X="G6_PF_ISGRT_RG=32 G6_PF_ATTN_ROWS=512 G6_PF_GEMMF32=1 G6_QO_CACHE=/opt/g6/tp5/qocache G6_PF_F12=1 G6_DEC_BK=512 G6_ATTN_P11=0 G6_ATTN_SC2=4 G6_ATTN_SC2_TR=2 G6_ATTN_CTX2=4 G6_ATTN_CTX3=4 G6_ATTN_SEL2=16 G6_IDX_GRP=16 G6_ATTN_QT=1 G6_ATTN_FRONT=1 G6_ROUTE_OVL=1 G6_DRAFT_HEAD_I4=1 G6_IDX_VEC=1 G6_RPLAN_WPT=1 G6_S2_ADAPT=1 G6_DEC_EVPROF=0 G6_PF_SELX_CTX=53248 G6_TR3_W2ALL=1 G6_DTR=1 G6_PF_AOP=0 G6_GVMULTI16=0 G6_CP_MERGE_STOP=2 G6_S2_DECODE_PF=4096 G6_S2_ADMIT_HOLD=1 G6_S2_DECODE_ROUNDS=16"

# Optional: an activation-steering profile applied to every request (our serve runs the ablit behaviour profile
# this way; the numbers in docs/TP5-SERVE.md were measured with it on). Remove these lines for stock behaviour.
#STEERING_PROFILE=/opt/g6/profile/<profile>
#STEERING_MODEL_REVISION=<revision>
#STEERING_TOKENIZER_REVISION=<revision>
#STEERING_CHAT_TEMPLATE_SHA256=<sha256>
#STEERING_FORCE=1
