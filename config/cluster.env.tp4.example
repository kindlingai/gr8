# TP4 (four Sparks): copy to config/cluster.env (or pass G6_CLUSTER=<file>) and edit. Every script reads it.
# Rank r runs on the r-th entry of each list. Rank 0 is the head: the launcher, shim and HTTP front end run there.

# ssh names of the four nodes, as the head reaches them (passwordless, BatchMode). If the head has no key of its own
# for the others, start the scripts from an `ssh -A` session to the head: the forwarded agent covers the launcher's
# ssh calls, and the shim's persistent ssh connections are opened at its start, so they outlive that session.
HOSTS="node1 node2 node3 node4"

# RoCE v2 address of each node on fabric rail 1 and rail 2 (one per PCIe root / HCA). The engine finds the RDMA
# device that owns each address itself (engine/comms/fabric.cpp).
IPS="10.0.1.1,10.0.1.2,10.0.1.3,10.0.1.4"
IPS2="10.0.2.1,10.0.2.2,10.0.2.3,10.0.2.4"

# Working directory on EVERY node (same path everywhere): bin/, packs/, serve/, out/. Nodes without the CUDA toolkit:
# build with BUNDLE_LIBS=1 (scripts/build.sh); stage.sh copies bin/lib (cuBLAS) next to the binary and launch_tp4.sh
# puts it on LD_LIBRARY_PATH.
G6_HOME=/opt/g6

# On the head: a dir with tokenizer.json, tokenizer_config.json, chat_template.jinja, generation_config.json
# (the TR3 checkpoint directory has all four).
MODEL_DIR=/opt/models/GLM-5.3-EXL3-TR3-3.25bpw

# CPU core for each rank's fabric proxy thread (GB10 has 20 cores, 0-19).
PROXY_CPU=19

# HTTP port of the OpenAI-compatible front end on the head.
PORT=8100

# Optional. The tensor-parallel size; ./gr8 glm53 takes it from the number of HOSTS, and refuses a TP= that disagrees.
#TP=4

# Optional. Where ./gr8 glm53 stage finds the packs (scripts/build_packs.sh's OUT_DIR), so `./gr8 glm53 stage` needs no argument.
#PACK_DIR=/data/packs

# Optional. Any launcher knob can sit here too (docs/SETTINGS.md). A value here wins over the same variable set on
# the command line, because every script sources this file. For example the KV pool:
#CAP=393216
