# TP5 T5X: the env file of the measured serve (5x DGX Spark, GLM-5.3 full, this branch = adapt-ai-systems/gr8-tp5
# main 0574fe5). Pass it to the launcher as `./gr8 glm53 up @T5X.env` on every box (boot.sh does that). Every
# non-comment line is identical to the deployed file (md5 139ef131e1941e9ff24139c1f7769ecc); only these comments differ.
# Site-specific values to change for another fleet: PY, MODEL, V2_DENSE, V2, V2_SLICES, PEERS/IPS/IPS2, G6_HOME,
# G6_QO_CACHE (inside G6ENV_X). config/cluster.env.tp5.example is the same config with neutral paths.
# STEERING_*: our serve applies our own activation-steering profile (ablit behaviour) to every request, and every
# number in README.md was measured with it on. Delete the five STEERING_* lines for stock model behaviour.
# CAP 617536 = KV pool tokens (max_model_len 617532).
PROXY_CPU=19
PORT=8000
S2PORT=7341
MTP=2
NOHASH=0
READY_TMO=1800
PY=/root/tp4w1/venv/bin/python
MODEL=/root/ablit/rel
G6ENV_X="G6_PF_ISGRT_RG=32 G6_PF_ATTN_ROWS=512 G6_PF_GEMMF32=1 G6_QO_CACHE=/root/tp5/qocache G6_PF_F12=1 G6_DEC_BK=512 G6_ATTN_P11=0 G6_ATTN_SC2=4 G6_ATTN_SC2_TR=2 G6_ATTN_CTX2=4 G6_ATTN_CTX3=4 G6_ATTN_SEL2=16 G6_IDX_GRP=16 G6_ATTN_QT=1 G6_ATTN_FRONT=1 G6_ROUTE_OVL=1 G6_DRAFT_HEAD_I4=1 G6_IDX_VEC=1 G6_RPLAN_WPT=1 G6_S2_ADAPT=1 G6_DEC_EVPROF=0 G6_PF_SELX_CTX=53248 G6_TR3_W2ALL=1 G6_DTR=1 G6_PF_AOP=0 G6_GVMULTI16=0 G6_CP_MERGE_STOP=2 G6_S2_DECODE_PF=4096 G6_S2_ADMIT_HOLD=1 G6_S2_DECODE_ROUNDS=16 G6_K1_TLBW=2048"
SHARE_LIMIT=4096
STEERING_PROFILE=/root/ablit/profile/ablit-behavior-v1
STEERING_MODEL_REVISION=f459f5d0272a529403dd9b3fd32f771f4250a0d4
STEERING_TOKENIZER_REVISION=f459f5d0272a529403dd9b3fd32f771f4250a0d4
STEERING_CHAT_TEMPLATE_SHA256=3740abcea51c45830cb3ca562084ad5fb2ef53589376f73332e9886f93ade41c
STEERING_FORCE=1
SESS=4
V2_DENSE=/root/ablit/rel
KVB=fp8
TP=5
SHAPE=mesh
PEERS=10.98.0.1,10.98.0.3,10.98.0.5,10.98.0.6,10.98.0.4
IPS=10.98.0.1,10.98.0.3,10.98.0.5,10.98.0.6,10.98.0.4
IPS2=10.96.0.1,10.96.0.3,10.96.0.5,10.96.0.6,10.96.0.4
G6_HOME=/root/tp5/gr8
V2_SLICES=/root/tp5/index-slices
V2=/root/tp5/experts
DFLASH=0
SPEC_ADAPT=0
PF_OWN=3
QA_SPLIT=1
IDXQ_SPLIT=1
MTP_SPLIT=1
CAP=617536
# K1_TLBW=2048 runs as G6_K1_TLBW in G6ENV_X: the K1_TLBW launch option is in open PR #107, not on main
