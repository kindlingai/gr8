# TP5 T5X: the env file of the measured serve (5x DGX Spark, GLM-5.3 full, this branch = adapt-ai-systems/gr8-tp5
# main 0574fe5). Pass it to the launcher as `./gr8 glm53 up @T5X.env` on every box (boot.sh does that). Every
# value is the deployed file's (md5 139ef131e1941e9ff24139c1f7769ecc) except the site-specific lines, which hold placeholders
# (example addresses, /opt/g6 paths).
# The deployed file carried 18 of these options as G6_ entries in EXTRA_ENV, and three variables no code reads
# (G6_CP_MERGE_STOP, G6_GVMULTI16, G6_RPLAN_WPT); here they are launcher options and the three are gone. The engine
# environment (`./gr8 glm53 show-config`, engine.env) is otherwise the same.
# Site-specific values to change for another fleet: PY, MODEL, V2_DENSE, V2, V2_SLICES, PEERS/IPS/IPS2, GR8_WORK_DIR,
# QO_CACHE.
# STEERING_*: our serve applies our own activation-steering profile (ablit behaviour) to every request, and every
# number in README.md was measured with it on. Delete the five STEERING_* lines for stock model behaviour.
# CAP 617536 = KV pool tokens (max_model_len 617532).
PROXY_CPU=19
PORT=8000
S2PORT=7341
MTP=2
NOHASH=0
READY_TMO=1800
PY=/opt/g6/venv/bin/python
MODEL=/opt/g6/release
EXTRA_ENV="GR8_DEC_BK=512 GR8_IDX_VEC=1 GR8_S2_ADAPT=1 GR8_DEC_EVPROF=0 GR8_PF_SELX_CTX=53248 GR8_TR3_W2ALL=1 GR8_S2_DECODE_PF=4096 GR8_S2_ADMIT_HOLD=1 GR8_S2_DECODE_ROUNDS=16 GR8_K1_TLBW=2048"
PF_ISGRT_RG=32
PF_ATTN_ROWS=512
PF_GEMMF32=1
QO_CACHE=/opt/g6/qocache
PF_F12=1
ATTN_P11=0
ATTN_SC2=4
ATTN_SC2_TR=2
ATTN_CTX2=4
ATTN_CTX3=4
ATTN_SEL2=16
IDX_GRP=16
ATTN_QT=1
ATTN_FRONT=1
ROUTE_OVL=1
DRAFT_HEAD_I4=1
DTR=1
PF_AOP=0
SHARE_LIMIT=4096
STEERING_PROFILE=/opt/g6/steering-profile
STEERING_MODEL_REVISION=f459f5d0272a529403dd9b3fd32f771f4250a0d4
STEERING_TOKENIZER_REVISION=f459f5d0272a529403dd9b3fd32f771f4250a0d4
STEERING_CHAT_TEMPLATE_SHA256=3740abcea51c45830cb3ca562084ad5fb2ef53589376f73332e9886f93ade41c
STEERING_FORCE=1
SESS=4
V2_DENSE=/opt/g6/release
KVB=fp8
TP=5
SHAPE=mesh
PEERS=10.0.0.1,10.0.0.2,10.0.0.3,10.0.0.4,10.0.0.5
IPS=10.0.0.1,10.0.0.2,10.0.0.3,10.0.0.4,10.0.0.5
IPS2=10.0.1.1,10.0.1.2,10.0.1.3,10.0.1.4,10.0.1.5
GR8_WORK_DIR=/opt/g6
V2_SLICES=/opt/g6/index-slices
V2=/opt/g6/experts
DFLASH=0
SPEC_ADAPT=0
PF_OWN=3
QA_SPLIT=1
IDXQ_SPLIT=1
MTP_SPLIT=1
CAP=617536
# K1_TLBW=2048 runs as GR8_K1_TLBW in EXTRA_ENV: the K1_TLBW launch option is in open PR #107, not on main
