# T5XR: OPTION ONLY, NEVER RUN AS A SERVE. T5X.env with G6_HOME = a build of the `rkv` branch and two KV-store lines
# (KV_STORE, KV_KEEP) at the end; a sixth Spark holds the KV store in RAM (`./gr8 kv up --gb 106`). The `rkv` commits
# (steered-run store fixes) are NOT in this PR. Measured in A/B arms and a tier-2 test only; see README.md.
# Every value is the staged file's (md5 8b14f50796bbb3573e15543d516eb8f5) except the site-specific lines, which hold
# placeholders (example addresses, /opt/g6 paths; G6_HOME /opt/g6-rkv = the rkv build, KV_STORE 10.0.0.6 = the KV box).
# The deployed file carried 18 of these options as G6_ entries in G6ENV_X, and three variables no code reads
# (G6_CP_MERGE_STOP, G6_GVMULTI16, G6_RPLAN_WPT); here they are launcher options and the three are gone. The engine
# environment (`./gr8 glm53 show-config`, engine.env) is otherwise the same.
PROXY_CPU=19
PORT=8000
S2PORT=7341
MTP=2
NOHASH=0
READY_TMO=1800
PY=/opt/g6/venv/bin/python
MODEL=/opt/g6/release
G6ENV_X="G6_DEC_BK=512 G6_IDX_VEC=1 G6_S2_ADAPT=1 G6_DEC_EVPROF=0 G6_PF_SELX_CTX=53248 G6_TR3_W2ALL=1 G6_S2_DECODE_PF=4096 G6_S2_ADMIT_HOLD=1 G6_S2_DECODE_ROUNDS=16 G6_K1_TLBW=2048"
PF_ISGRT_RG=32
PF_ATTN_ROWS=512
PF_GEMMF32=1
QO_CACHE=/opt/g6/qocache
PF_F12=1
ATTN_P11=0
ATTN_SC2=4
ATTN_SC2_TR=2
ATTN_CTX2=4
ATTN_CTX3=4
ATTN_SEL2=16
IDX_GRP=16
ATTN_QT=1
ATTN_FRONT=1
ROUTE_OVL=1
DRAFT_HEAD_I4=1
DTR=1
PF_AOP=0
SHARE_LIMIT=4096
STEERING_PROFILE=/opt/g6/steering-profile
STEERING_MODEL_REVISION=f459f5d0272a529403dd9b3fd32f771f4250a0d4
STEERING_TOKENIZER_REVISION=f459f5d0272a529403dd9b3fd32f771f4250a0d4
STEERING_CHAT_TEMPLATE_SHA256=3740abcea51c45830cb3ca562084ad5fb2ef53589376f73332e9886f93ade41c
STEERING_FORCE=1
SESS=4
V2_DENSE=/opt/g6/release
KVB=fp8
TP=5
SHAPE=mesh
PEERS=10.0.0.1,10.0.0.2,10.0.0.3,10.0.0.4,10.0.0.5
IPS=10.0.0.1,10.0.0.2,10.0.0.3,10.0.0.4,10.0.0.5
IPS2=10.0.1.1,10.0.1.2,10.0.1.3,10.0.1.4,10.0.1.5
G6_HOME=/opt/g6-rkv
V2_SLICES=/opt/g6/index-slices
V2=/opt/g6/experts
DFLASH=0
SPEC_ADAPT=0
PF_OWN=3
QA_SPLIT=1
IDXQ_SPLIT=1
MTP_SPLIT=1
CAP=617536
# K1_TLBW=2048 runs as G6_K1_TLBW in G6ENV_X: the K1_TLBW launch option is in open PR #107, not on main
KV_STORE=remote:10.0.0.6:7350,size=21G
KV_KEEP=sessions
