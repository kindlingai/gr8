# TP6 K3 at 613K context: the env file of the measured serve (6x DGX Spark, GLM-5.3, gr8 at c53b5b8 + the 39 recipe
# patches on this branch, source tree 25aa805615409f1375f7709ea960e200e24af13d). Pass it to the launcher as
# `./gr8 glm53 up @K3-cap613-sl131k.env` on every box (handboot.sh does that). Every non-comment line is identical to
# the deployed file (md5 234b0a8070bb44175538b686de4fbda5) except the site-specific lines below, which hold placeholders
# (example addresses, /opt/g6 paths), and MODEL, which is the exlr8 release here: the measured serve booted converted
# rank packs (tag tp6-k3-613k-measured dd67022), which the launcher no longer reads (README.md, Boot).
# Site-specific values to change for another fleet: PY, MODEL, PEERS/IPS/IPS2, GR8_WORK_DIR, FRONT_BIN.
# KVB=bf16 / GR8_KVB=bf16: with the measured converted packs they had no effect (boot log "KV format fp8 (latent row
# 656 B)"); from the release, bf16 is kv_b's form (GR8_KVB, #98).
# CAP 612992 = 9578 x 64-token pages (max_model_len 612986). SHARE_LIMIT 131072 = R, see README.md for why.
TP=6
PROXY_CPU=19
PORT=8000
S2PORT=7341
MTP=3
DFLASH=0
SPEC_ACCEPT=rejection
SESS=4
CAP=612992
SHARE_LIMIT=131072
NOHASH=0
READY_TMO=600
PY=/opt/g6/venv/bin/python
MODEL=/opt/g6/release
KVB=bf16
SHAPE=mesh
PEERS=10.0.0.1,10.0.0.2,10.0.0.3,10.0.0.4,10.0.0.5,10.0.0.6
IPS=10.0.0.1,10.0.0.2,10.0.0.3,10.0.0.4,10.0.0.5,10.0.0.6
IPS2=10.0.1.1,10.0.1.2,10.0.1.3,10.0.1.4,10.0.1.5,10.0.1.6
GR8_WORK_DIR=/opt/g6
FRONT_BIN=/opt/g6/bin/g6front-rs
# raw G6_ only where the launcher option is on an open PR (L2PF #108, K1_SPLIT/K1_TLBW #107, CP_STEP_ROWS #106,
# MTP_KSTOPB* #113) or the variable is a log (GR8_MTP_LPLOG)
EXTRA_ENV="GR8_L2PF=31 GR8_K1_SPLIT=1:/4,2-3:2x1,4-32:8x1/4 GR8_K1_TLBW=2048 GR8_CP_STEP_ROWS=8 GR8_MTP_KSTOPB=1 GR8_MTP_LPLOG=1 GR8_MTP_KSTOPB_TAU_S2=0.7,0.8,0.9 GR8_MTP_KSTOPB_TAU_S3=0.7,0.88,0.95 GR8_MTP_KSTOPB_TAU_S4=0.7,0.75,0.9"
PF_GEMMF32=1
QA_SPLIT=1
IDXQ_SPLIT=1
MTP_SPLIT=1
ROUTE_OVL=1
ATTN_SC2=4
ATTN_SC2_TR=2
ATTN_CTX2=4
ATTN_CTX3=2
ATTN_SEL2=16
IDX_GRP=16
ATTN_QT=1
ATTN_FRONT=1
MTP_LASTROW=1
DRAFT_HEAD_I4=1
DRAFT_HEAD2=1
ATTN_POSIDX=1
MTP_KSTOP=1
MTP_KSTOP_KMAX=3
MTP_KSTOP_TAU=0,0.5,0.75
MTP_KSTOPB_WIDTHS=2,3,5,6,7,9,10,11,13,14,15
MTP_L2PF=3
