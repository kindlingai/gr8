# TP6 K3 at 613K context: the env file of the measured serve (6x DGX Spark, GLM-5.3, gr8 at c53b5b8 + the 39 recipe
# patches on this branch, source tree 25aa805615409f1375f7709ea960e200e24af13d). Pass it to the launcher as
# `./gr8 glm53 up @K3-cap613-sl131k.env` on every box (handboot.sh does that). Every non-comment line is identical to
# the deployed file (md5 234b0a8070bb44175538b686de4fbda5); only these comments differ.
# Site-specific values to change for another fleet: PY, MODEL, MODEL_DIR, PEERS/IPS/IPS2, G6_HOME, FRONT_BIN.
# KVB=bf16 / G6_KVB=bf16 have no effect with converted packs: the boot log reports "KV format fp8 (latent row 656 B)".
# CAP 612992 = 9578 x 64-token pages (max_model_len 612986). SHARE_LIMIT 131072 = R, see README.md for why.
TP=6
PROXY_CPU=19
PORT=8000
S2PORT=7341
MTP=3
DFLASH=0
SPEC_ACCEPT=rejection
SESS=4
CAP=612992
SHARE_LIMIT=131072
NOHASH=0
READY_TMO=600
PY=/root/tp4w1/venv/bin/python
MODEL=/root/tp6pk/packs
MODEL_DIR=/root/ablit/rel
KVB=bf16
SHAPE=mesh
PEERS=10.98.0.1,10.98.0.2,10.98.0.3,10.98.0.4,10.98.0.5,10.98.0.6
IPS=10.98.0.1,10.98.0.2,10.98.0.3,10.98.0.4,10.98.0.5,10.98.0.6
IPS2=10.96.0.1,10.96.0.2,10.96.0.3,10.96.0.4,10.96.0.5,10.96.0.6
G6_HOME=/root/tp6-knapcio
FRONT_BIN=/root/tp6/gr8/bin/g6front-rs
G6ENV_X="G6_PF_GEMMF32=1 G6_QA_SPLIT=1 G6_IDXQ_SPLIT=1 G6_MTP_SPLIT=1 G6_ROUTE_OVL=1 G6_ATTN_SC2=4 G6_ATTN_SC2_TR=2 G6_ATTN_CTX2=4 G6_ATTN_CTX3=2 G6_ATTN_SEL2=16 G6_IDX_GRP=16 G6_ATTN_QT=1 G6_ATTN_FRONT=1 G6_L2PF=31 G6_K1_SPLIT=1:/4,2-3:2x1,4-32:8x1/4 G6_K1_TLBW=2048 G6_KVB=bf16 G6_CP_STEP_ROWS=8 G6_MTP_LASTROW=1 G6_DRAFT_HEAD_I4=1 G6_DRAFT_HEAD2=1 G6_ATTN_POSIDX=1 G6_MTP_KSTOP=1 G6_MTP_KSTOP_KMAX=3 G6_MTP_KSTOP_TAU=0,0.5,0.75 G6_MTP_KSTOPB=1 G6_MTP_LPLOG=1 G6_MTP_KSTOPB_TAU_S2=0.7,0.8,0.9 G6_MTP_KSTOPB_TAU_S3=0.7,0.88,0.95 G6_MTP_KSTOPB_TAU_S4=0.7,0.75,0.9 G6_MTP_KSTOPB_WIDTHS=2,3,5,6,7,9,10,11,13,14,15 G6_MTP_L2PF=3"
