#!/bin/bash
# The one entry point: ./gr8 <model> <command>, the model glm53 (GLM-5.3), glm53f (GLM-5.3-Flash) or pseudo (the
# pseudo engine, frontend/pseudo-engine: the launcher commands, smoke, bench and build); ./gr8 kv runs a KV node. Run the same command on every box, from the repo checkout
# on that box. Each box's supervisor (tools/launch) finds the others, checks that every box has the same
# options, model set and engine, and starts its own rank. The head (rank 0) also runs the front end and the shim.
#
#   ./gr8 glm53 up [OPTIONS] [@FILE]  start this box's supervisor and follow it until the cluster serves
#        --tp 4|6|3 --peers A,B,C,D   the boxes' LAN addresses, the same list on every box, head first
#        --mentat localhost           or: find the other boxes through the local mentat daemon (the default)
#        --model URL|DIR              the exlr8 release, https://huggingface.co/<org>/<repo>[@rev] or a local copy of
#                                     it. The engine plans every rank's weights from its files
#        --model-cache DIR            this box's local directory for its shard (alone: boot from it)
#        --drafter URL                TP=4 or 6: the DFlash2 drafter's repo, fetched and converted on each box
#        --cap 262144, --sess 4, ...  every knob in KNOBS.md, as --<knob> VALUE
#   ./gr8 glm53 down                  stop every box of the last boot
#   ./gr8 glm53 restart [OPTIONS]     down, then up
#   ./gr8 glm53 status                every box's state, engine and MemAvailable, and the head's shim, front end, /health
#   ./gr8 glm53 health                exit 0 when this box serves (on the head, its /health answers too), else 1: a
#                                     readiness check for compose and Kubernetes probes, on every rank
#   ./gr8 glm53 logs [r|shim|front|supervisor] [-f]   a log from any box (default this box's engine)
#   ./gr8 glm53 check [OPTIONS]       what would stop this box's boot
#   ./gr8 glm53 show-config [OPTIONS] the effective options, the cluster options the boxes compare, the model set id
#   ./gr8 glm53 prepare [--rank R] [OPTIONS]   fill --model-cache with this box's part without booting
#   ./gr8 glm53 smoke [URL]           smoketest/run.sh, by default against this head's API
#   ./gr8 glm53 bench [ARGS]          bench/pbench.py against this head's API
#   ./gr8 glm53 build [OUT_DIR]       scripts/build.sh (one engine for every TP width) and scripts/build_front.sh; with
#                                     KV_FORMAT=int4 (or --kv-format int4 in the options) also bin/g6m4-int4
#
#   ./gr8 kv up --gb N [OPTIONS]      lock N GiB of this box's memory and serve it as KV page blocks to the cluster
#                                     (engine/kvman-rs/REMOTE-TIER.md), announced in the mentat group; ./gr8 kv --help
#   ./gr8 kv down | status [all] | health | logs [-f]
#
#   ./gr8 query [OPTIONS] PROMPT      one chat prompt streamed to the terminal, thinking dim (tools/query/query.py):
#                                     --api URL, --steer PROFILE[:SCALE], --effort, --record/--replay FILE, --window 40x10
#
#   ./gr8 test [frontend|engine|all]  the CPU tests CI runs (.github/ci/cpu-tests.sh), all by default; docs/TESTING.md
#   ./gr8 test pseudo TOKENIZER_DIR   the smoke test and the front end's API tests against the pseudo engine, no GPU
#   ./gr8 test gpu [BIN_DIR]          the one-GPU unit tests (scripts/c1_tests.sh)
#
# Options come from the command line, then one config file (@FILE, else ./cluster.env, else config/cluster.env, which
# ./gr8 parses and does not source), then the environment, then the defaults. An old config file works: HOSTS is read as PEERS. KNOBS.md
# lists every option.
# --no-check (or CHECK=0) boots without the checks.
set -eu
REPO=$(cd "$(dirname "$0")" && pwd)
SCRIPTS=$REPO/scripts
check=1
[ "${CHECK:-1}" = 0 ] && check=0

usage() { sed -n '2,/^set -eu$/{/^set -eu$/d;s/^# \{0,1\}//;p;}' "$0"; }

options() {
  while [ $# -gt 0 ]; do
    case $1 in
      --no-check) check=0; shift ;;
      -h|--help|help) usage; exit 0 ;;
      *) break ;;
    esac
  done
  rest=("$@")
}
options "$@"; set -- ${rest[@]+"${rest[@]}"}
[ $# -gt 0 ] || { usage; exit 0; }
model=$1
case $model in
  glm53) build_model=glm ;;
  glm53f) build_model=flash ;;
  pseudo) build_model=pseudo ;;
  kv) shift; exec python3 "$REPO/tools/launch/kvnode.py" "$@" ;;
  query) shift; exec python3 "$REPO/tools/query/query.py" "$@" ;;
  test)
    shift
    case ${1:-all} in
      frontend|engine|all) exec bash "$REPO/.github/ci/cpu-tests.sh" "${1:-all}" ;;
      pseudo) shift; bash "$REPO/frontend/pseudo-engine/smoke.sh" "$@"; exec bash "$REPO/frontend/tests/api.sh" "$@" ;;
      gpu) shift; exec bash "$SCRIPTS/c1_tests.sh" "$@" ;;
      *) echo "gr8: ./gr8 test [frontend|engine|all], ./gr8 test pseudo TOKENIZER_DIR or ./gr8 test gpu [BIN_DIR]" >&2; exit 2 ;;
    esac ;;
  *) echo "gr8: the first argument names the model, glm53, glm53f or pseudo: ./gr8 glm53 <command> (or ./gr8 kv, ./gr8 query, ./gr8 test)" >&2; exit 2 ;;
esac
shift
export GR8_MODEL=$model   # tools/launch/options.py
options "$@"; set -- ${rest[@]+"${rest[@]}"}
[ $# -gt 0 ] || { usage; exit 0; }
cmd=$1; shift
args=()
for a in "$@"; do
  case $a in
    --no-check) check=0 ;;
    *) args+=("$a") ;;
  esac
done
set -- ${args[@]+"${args[@]}"}
api() { echo "http://127.0.0.1:$PORT"; }
case $cmd in
  up|down|restart|status|health|logs|check|show-config|prepare)
    [ $check = 0 ] && set -- "$@" --no-check
    exec python3 "$REPO/tools/launch/launch.py" "$cmd" "$@" ;;
  smoke)
    PORT=$(python3 "$REPO/tools/launch/launch.py" get PORT) || exit 2   # the port as up reads it, from the same file
    url=${1:-$(api)}; [ $# -gt 0 ] && shift
    exec bash "$REPO/smoketest/run.sh" "$url" "$@" ;;
  bench)
    PORT=$(python3 "$REPO/tools/launch/launch.py" get PORT) || exit 2
    exec python3 "$REPO/bench/pbench.py" --url "$(api)" "$@" ;;
  build)
    out=${1:-$REPO/bin}
    if [ "$build_model" = pseudo ]; then
      (cd "$REPO/frontend/pseudo-engine" && cargo build --release --locked)
      mkdir -p "$out" && cp "$REPO/frontend/pseudo-engine/target/release/g6pseudo" "$out/"
      exec "$SCRIPTS/build_front.sh" "$out"
    fi
    [ -n "${KV_FORMAT:-}" ] || KV_FORMAT=$(python3 "$REPO/tools/launch/launch.py" get KV_FORMAT 2> /dev/null) || KV_FORMAT=""
    # MODEL here is scripts/build.sh's (glm or flash), not the launcher's release
    MODEL=$build_model KV_FORMAT=fp8 "$SCRIPTS/build.sh" "$out"
    # the int4 KV engine (--kv-format int4) only when asked: it is a second full g6m4 build
    if [ "$KV_FORMAT" = int4 ]; then MODEL=$build_model KV_FORMAT=int4 "$SCRIPTS/build.sh" "$out"; fi
    exec "$SCRIPTS/build_front.sh" "$out" ;;
  *)
    echo "unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac
