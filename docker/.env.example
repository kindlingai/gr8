# Copy to .env next to compose.yaml (docker/.env in a checkout, not the repo root) on every box: docs/DEPLOY.md. Compose
# passes each line into the container, where the launcher reads it as an option. ./gr8 knobs lists every option and its
# default. Set only what this cluster needs: a value here wins over the launcher's default, including a tuned one.

# --- the model -------------------------------------------------------------------------------------------------------
# Required, no default: glm53 (GLM-5.3) or glm53f (GLM-5.3-Flash), and MODEL a release of that model.
# `./gr8 models` lists each model's release, TP sizes and variants. For GLM-5.3-Flash:
#   GR8_MODEL=glm53f and MODEL=https://huggingface.co/kindlingai/glm-5.3-flash-exlr8-k2-k3-k4, without DRAFTER
GR8_MODEL=glm53
MODEL=https://huggingface.co/kindlingai/glm-5.3-exlr8-k2-k3-k4
# glm53 at TP=4 only: the DFlash2 drafter. Its licence forbids sharing a converted copy, so each box converts its own.
DRAFTER=https://huggingface.co/incoai/GLM-5.3-DFlash2
# The exlr8 width manifest: home (the default at TP=4 and TP=6), bit225 (the default at TP=3), down1, up1, bit243,
# bit260, bit325, bit338. ./gr8 knobs VARIANT says what each one is.
#VARIANT=bit225
# Sent only to Hugging Face, for a gated or private repo.
#HF_TOKEN=

# --- the boxes -------------------------------------------------------------------------------------------------------
# The LAN address of every box, in rank order, the same line on every box. The first is the head (OpenAI API on
# port 8100). TP is the number of addresses. Unset, the boxes find each other through the mentat daemon on each box
# (MENTAT=localhost), and TP must be set.
PEERS=192.0.2.1,192.0.2.2,192.0.2.3,192.0.2.4
#TP=4
# No switch: the boxes are cabled in a ring, in PEERS order (README, "What you need").
#SHAPE=ring
# Per box: this box's LAN address, when PEERS holds more than one address of this box.
#NODE_IP=

# --- the container ---------------------------------------------------------------------------------------------------
# Read by compose (the launcher ignores them). Unset, the published image and two named volumes.
#GR8_IMAGE=ghcr.io/kindlingai/gr8:latest
# A host directory for this box's part of the model (~90 GB at TP=4), owned by uid 1000.
#GR8_CACHE=/srv/gr8/cache
# A host directory for logs and state, owned by uid 1000.
#GR8_HOME=/srv/gr8/home
# With docker/model-loader.yaml: model-loader's store on this box (mounted read-only), and its image for the wait.
#MODEL_LOADER_STORE=/var/lib/model-loader
#MODEL_LOADER_IMAGE=ghcr.io/kindlingai/model-loader:latest

# --- fast restarts and switches (GLM-5.3) ----------------------------------------------------------------------------
# Each setting below was measured to make a GLM-5.3 start or stop faster: docs/SWITCHING.md has the runs and the numbers
# per drive class, docs/ENV.md describes each knob. Every rank needs the same lines.
# - GR8_GEN_CACHE: the loader keeps the tensors it computes at load and reads them back at the next boot of the same
#   engine build (GLM-5.3 TP=4: engines ready 71 s without it, 68 s after; docs/FIRST-BOOT.md).
# - GR8_QUIT_FAST=1: at an orderly stop the engine ends right after the quit barrier. Stopping all four TP=4 engines took
#   2.43-3.20 s instead of 4.41-5.83 s (three stops each). GLM-5.3 only; GLM-5.3-Flash ignores it.
# - GR8_LOAD_COMPACT + GR8_LOAD_MERGE_KB=1: the loader reads dense per-rank copies of its expert ranges. A switch into
#   GLM-5.3 at TP=4 took about 47 s instead of 76 s. The copies exist only after prepare writes them: with this line in
#   place, run `docker compose run --rm gr8 prepare` once on every box (about 70 GiB a box beside the release; prepare
#   on a disk with room, copies written onto a nearly full disk read slower). Until then the loader reads the release
#   as before. A new release, TP size, variant or layout needs a new directory (docs/COMPACT-WEIGHTS.md).
EXTRA_ENV="GR8_GEN_CACHE=/var/lib/gr8/cache/gen-cache GR8_QUIT_FAST=1 GR8_LOAD_COMPACT=/var/lib/gr8/cache/compact-tp4 GR8_LOAD_MERGE_KB=1"
# GLM-5.3-Flash at TP=2 instead: the compact copies paid only together with GR8_LOAD_MERGE_KB=1 (a switch into it took
# 22.9-25.8 s instead of 29.5-33.5 s; the copies alone changed nothing). Run prepare the same way.
#EXTRA_ENV="GR8_LOAD_COMPACT=/var/lib/gr8/cache/compact-tp2 GR8_LOAD_MERGE_KB=1"
# GLM-5.3: a persistent SSD KV store. At an orderly stop the engine stores the chats it still holds, and the next boot
# reads them back: a chat resumed after a switch away and back answered its next turn in 0.16-0.21 s, where a cold
# prefill of the same chat took about 3.8 s. GR8_STOP_GRACE gives docker's stop the time that store needs; without it,
# docker kills the engine mid-store. Not measured on GLM-5.3-Flash.
KV_STORE=ssd:/var/lib/gr8/cache/kv,size=200G,persist=on,keep=sessions
GR8_STOP_GRACE=150s
