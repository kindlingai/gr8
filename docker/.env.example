# Copy to docker/.env (next to compose.yaml, not the repo root) on every box. Compose passes each line into the
# container, where the launcher reads it as an option. KNOBS.md lists every option and its default. Set only what this
# cluster needs: a value here wins over the launcher's default, including a tuned one.

# --- the model -------------------------------------------------------------------------------------------------------
MODEL=https://huggingface.co/kindlingai/glm-5.3-exlr8-k2-k3-k4
# TP=4 only: the DFlash2 drafter. Its licence forbids sharing a converted copy, so each box converts its own.
DRAFTER=https://huggingface.co/incoai/GLM-5.3-DFlash2
# The exlr8 width manifest: home (the default at TP=4), down1 (the default at TP=3), up1.
#VARIANT=down1
# Sent only to Hugging Face, for a gated or private repo.
#HF_TOKEN=

# --- the boxes -------------------------------------------------------------------------------------------------------
# The LAN address of every box, in rank order, the same line on every box. The first is the head (OpenAI API on
# port 8100). TP is the number of addresses. Unset, the boxes find each other through the mentat daemon on each box
# (MENTAT=localhost), and TP must be set.
PEERS=192.0.2.1,192.0.2.2,192.0.2.3,192.0.2.4
#TP=4
# No switch: the boxes are cabled in a ring, in PEERS order (README, "What you need").
#SHAPE=ring
# Per box: this box's LAN address, when PEERS holds more than one address of this box.
#NODE_IP=

# --- the container ---------------------------------------------------------------------------------------------------
# Read by compose (the launcher ignores them). Unset, the published image and two named volumes.
#GR8_IMAGE=ghcr.io/kindlingai/gr8:latest
# A host directory for this box's part of the model (~90 GB at TP=4), owned by uid 1000.
#GR8_CACHE=/srv/gr8/cache
# A host directory for logs and state, owned by uid 1000.
#GR8_HOME=/srv/gr8/home
