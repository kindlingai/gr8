#!/usr/bin/env python3
"""Stub front end for the supervisor tests: /health is 200 once the engine socket accepts a connection, else 503.
Its arguments go to out/front.json next to the engine socket's run/ directory."""
import argparse
import http.server
import json
import os
import socket

ap = argparse.ArgumentParser()
ap.add_argument('--model-dir')
ap.add_argument('--engine-sock')
ap.add_argument('--port', type=int)
ap.add_argument('--default-max-tokens', type=int)
ap.add_argument('--share-tokens', type=int)
ap.add_argument('--default-reasoning-effort')
ap.add_argument('--default-thinking-budget', type=int)
ap.add_argument('--supervisor')
a = ap.parse_args()
with open(os.path.join(os.path.dirname(os.path.dirname(a.engine_sock)), 'out', 'front.json'), 'w') as f:
    json.dump(vars(a), f)


class H(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        ok = False
        try:
            with socket.socket(socket.AF_UNIX) as s:
                s.connect(a.engine_sock)
                ok = True
        except OSError:
            pass
        self.send_response(200 if ok and self.path == '/health' else 503)
        self.end_headers()

    def log_message(self, *_):
        pass


http.server.HTTPServer(('127.0.0.1', a.port), H).serve_forever()
