#!/bin/sh
# Stub ssh for the supervisor tests: every box is this machine, so run the command here. A master (-fN) or a control
# request (-O) does nothing.
while [ $# -gt 0 ]; do
  case $1 in
    -o) shift 2 ;;
    -fN|-O) exit 0 ;;
    -*) shift ;;
    *) break ;;
  esac
done
shift   # the host
exec sh -c "$*"
