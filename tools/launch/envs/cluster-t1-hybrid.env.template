# T1 (window 1) hybrid env, ONE rank. Do not fill this by hand for a real window: generate the per-rank files from the
# saved C serve env with   python3 tools/launch/envs/t1env.py C.env --home <TEST_G6_HOME> --control-port <PORT> --out <DIR>
# so MODEL, the knobs, G6ENV_X and steering stay byte-identical to C (the byte oracle) and only these keys change.
# Placeholders below are <ANGLE> names; addresses are documentation ranges.

# --- copied verbatim from C (shown for shape only) ---
TP=4
PROXY_CPU=19
PORT=8000
S2PORT=7341
PEERS=<LAN0>,<LAN1>,<LAN2>,<LAN3>
MODEL=<C_MODEL_DIR>
# CAP, SESS, MTP, DFLASH, SPEC_ADAPT, PF_OWN, SHARE_LIMIT, G6ENV_X, STEERING_* ... exactly as in C

# --- removed from C ---
# IPS, IPS2: hybrid refuses them; each box declares its own fabric ports instead

# --- set by t1env.py ---
SHAPE=hybrid
# the staged test tree, never the serve tree (the engine runs relative to G6_HOME)
G6_HOME=<TEST_G6_HOME>
# its own port: not C's CONTROL_PORT, not 7340, not PORT/S2PORT, not 18600-18663
CONTROL_PORT=<TEST_CONTROL_PORT>
# this rank's IPS entry first, then its IPS2 entry: declaration order is the canonical rail order, so T1a keeps C's
# rail layout. Example for rank 0:
FAB_PORTS=192.0.2.10/24,198.51.100.10/24
# optional (T1b): rank pairs that must relay instead of going direct
#FAB_DENY=0-2,1-3
